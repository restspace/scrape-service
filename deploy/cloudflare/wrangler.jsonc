{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scrape-service",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Non-secret settings. Secrets (set once with `npx wrangler secret put`):
  //   SCRAPE_TOKEN          bearer the RS2 /scrape proxy mount injects
  //   R2_ACCOUNT_ID         account holding the bucket
  //   R2_ACCESS_KEY_ID      R2 API token, Object Read & Write on R2_BUCKET only
  //   R2_SECRET_ACCESS_KEY
  //
  // Optional vars, read by src/index.js with these defaults:
  //   CONCURRENT_JOBS         "2"   jobs run at once; sized for instance_type below
  //   MAX_PAGES_CEILING       "120"
  //   ARTEFACT_BYTES_PER_JOB  1 GiB
  //   ARTEFACT_TTL_DAYS       "7"
  //   CRAWLER_USER_AGENT, CRAWLER_ROBOTS_TOKEN   the crawler's identity; unset
  //                           means the service default (RapiderITBot). Set both.
  "vars": {
    "R2_BUCKET": "rs2-files"
  },

  "containers": [
    {
      "class_name": "ScrapeContainer",
      // Built from the repository root so the image gets src/ and config/.
      "image": "../../Dockerfile",
      "image_build_context": "../..",
      // standard-2: 1 vCPU, 6 GiB memory, 12 GB disk (Cloudflare Containers
      // limits page, checked 2026-10-09). The smallest type with a full vCPU,
      // which two concurrent jobs need: each job is its own Chromium, and on
      // standard-1 (1/2 vCPU, 4 GiB, 8 GB) two would have had a quarter vCPU
      // each. Memory is not the constraint: one crawl peaked at 887 MiB on
      // EC2, so two are about 1.8 GiB. CONCURRENT_JOBS defaults to 2 in
      // src/index.js; change the two together.
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "SCRAPER", "class_name": "ScrapeContainer" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScrapeContainer"] }],

  "observability": { "enabled": true }
}
